# =====================================================
# SISTEMA IVN - Variáveis de ambiente para Docker
# Copie para .env e ajuste os valores
# =====================================================

# Porta da aplicação exposta no host
APP_PORT=3000

# Banco de dados
DB_PASSWORD=troque-por-uma-senha-forte
DB_PORT_EXTERNAL=5432

# JWT (segredo para tokens de autenticação)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=7d

# URL do frontend (para links em emails)
FRONTEND_URL=http://localhost:3000

# SMTP para envio de emails (opcional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema IVN <noreply@exemplo.com>"

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
