# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=igreja_db
DB_USER=igreja_user
DB_PASSWORD=123456

# JWT Configuration
JWT_SECRET=seu_jwt_secret_aqui_mude_em_producao
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Storage: local (disco) ou s3 (MinIO / AWS S3)
# STORAGE_TYPE=local
# STORAGE_TYPE=s3

# S3 / MinIO (usado quando STORAGE_TYPE=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=sistema-ivn
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false
# S3_REGION=us-east-1
