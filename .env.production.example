# =====================================================
# SISTEMA IVN - Variáveis para Produção (Swarm)
# Copie para .env.production e preencha com dados reais
# =====================================================

# Banco de dados PostgreSQL (servidor externo)
DB_HOST=postgres-host-ou-ip
DB_PORT=5432
DB_NAME=igreja_db
DB_USER=postgres
DB_PASSWORD=senha-forte-do-banco

# JWT (use um segredo forte e único)
JWT_SECRET=gere-um-segredo-aleatorio-muito-forte-aqui
JWT_EXPIRES_IN=7d

# URL do frontend (para links em emails)
FRONTEND_URL=https://ivn.exemplo.top

# Storage: local (arquivos em volume) ou s3 (MinIO/S3)
# STORAGE_TYPE=local
# STORAGE_TYPE=s3

# S3 / MinIO (somente quando STORAGE_TYPE=s3)
# S3_ENDPOINT=http://minio:9000
# S3_BUCKET=sistema-ivn
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_SSL=false
# S3_REGION=us-east-1

# SMTP para envio de emails (opcional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema IVN <noreply@exemplo.com>"

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=https://ivn.exemplo.top,https://www.ivn.exemplo.top
