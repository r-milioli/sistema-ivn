# =====================================================
# SISTEMA IVN - Variáveis para Produção (Swarm)
# Copie para .env.production e preencha com dados reais
# =====================================================

# Banco de dados PostgreSQL (servidor externo)
DB_HOST=postgres-host-ou-ip
DB_PORT=5432
DB_NAME=igreja_db
DB_USER=postgres
DB_PASSWORD=senha-forte-do-banco

# JWT (use um segredo forte e único)
JWT_SECRET=gere-um-segredo-aleatorio-muito-forte-aqui
JWT_EXPIRES_IN=7d
